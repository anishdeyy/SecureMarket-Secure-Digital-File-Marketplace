# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev, no setup needed):
DATABASE_URL=sqlite:///./securemarket.db
# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://securemarket:securemarket@localhost:5432/securemarket

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
AI_MODE=gemini          # gemini | mock
GEMINI_API_KEY=         # your Gemini API key

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_MODE=local      # local | s3
LOCAL_STORAGE_PATH=./storage
S3_SIGNED_URL_EXPIRATION=300

# ── Payment (Razorpay) ────────────────────────────────────────────────────────
PAYMENT_MODE=razorpay   # razorpay | mock
RAZORPAY_KEY_ID=        # rzp_test_...
RAZORPAY_KEY_SECRET=    # your Razorpay secret
RAZORPAY_WEBHOOK_SECRET=

# ── Malware Scanning ──────────────────────────────────────────────────────────
MALWARE_SCAN_MODE=mock  # mock | clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Redis (optional, for rate limiting) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AWS (only needed for S3 storage) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
DEFAULT_DOWNLOAD_LIMIT=5

# ── CORS / URLs ───────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000

# ── Frontend (.env.local) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
# NEXT_PUBLIC_PAYMENT_MODE=razorpay
